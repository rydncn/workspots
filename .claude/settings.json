{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./secrets/**)"
    ],
    "ask": [
      "Bash(git push*main*)",
      "Bash(git push*--force*)",
      "Bash(git push* -f*)",
      "Bash(git push* +*)",
      "Bash(git push*--delete*)",
      "Bash(git push*--mirror*)",
      "Bash(gh pr merge*)",
      "Bash(gh release *)",
      "Bash(docker push*)",
      "Bash(kubectl apply*)",
      "Bash(kubectl delete*)"
    ],
    "allow": [
      "Bash(go build*)",
      "Bash(go vet*)",
      "Bash(go test*)",
      "Bash(gofmt*)",
      "Bash(staticcheck*)",
      "Bash(govulncheck*)",
      "Bash(scripts/dev-db.sh)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/check-plugins.mjs"], "timeout": 45 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/context-budget.mjs"], "timeout": 10 }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/after-edit.mjs"], "timeout": 60 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/before-stop.mjs"], "timeout": 300 }] }
    ]
  }
}
